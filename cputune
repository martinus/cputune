def color_help(text: str, theme) -> str:
    """HELP in the colors of the argparse theme: the headers as "options:", the commands as in
    "usage:", FREQ and CPUS as the labels in the option list. The plain text stays plain."""
    def options(part: str) -> str:  # as argparse colors the usage line
        part = re.sub(r"(?<![\w-])(--?[a-z][a-z-]*)", lambda m: (
            theme.summary_long_option if m[1].startswith("--") else theme.summary_short_option
        ) + m[1] + theme.reset, part)
        part = re.sub(r"(?<![\w-])([A-Z]+)(?![\w-])", lambda m: theme.summary_label + m[1] + theme.reset, part)
        return re.sub(r"\{[^}]*\}", lambda m: theme.summary_label + m[0] + theme.reset, part)

    lines, section = [], ""
    for line in text.split("\n"):
        if re.fullmatch(r"[a-z][a-z ]*:", line):
            section = line
            line = theme.heading + line + theme.reset
        elif line.startswith("  cputune"):  # a command, then (after two spaces) what it does
            end = line.find("  ", 2)
            command, rest = (line[2:end], line[end:]) if end > 0 else (line[2:], "")
            prog, _, args = command.partition(" ")
            name, _, args = args.partition(" ") if args[:1].isalpha() or args.startswith("[show]") else ("", "", args)
            name = " " + theme.prog_extra + name + theme.reset if name else ""
            line = "  " + theme.prog + prog + theme.reset + name + (" " + options(args) if args else "") + rest
        elif section == "values:" and (m := re.match(r"  ([A-Z]+)( .*)", line)):
            line = "  " + theme.label + m[1] + theme.reset + m[2]
        lines.append(line)
    return "\n".join(lines)


class HelpFormatter(argparse.RawDescriptionHelpFormatter):
    """HELP in the colors of argparse. argparse decides: Python 3.14 and newer, in a terminal,
    without NO_COLOR. Else no colors, also in HELP."""

    def _format_text(self, text: str) -> str:
        text = super()._format_text(text)
        theme = getattr(self, "_theme", None)  # set by argparse 3.14 and newer
        return color_help(text, theme) if theme is not None and theme.reset else text


def build_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="print machine-readable JSON")
    common.add_argument("--color", choices=("auto", "always", "never"), default=argparse.SUPPRESS,
                        help="use colors (default: auto)")

    parser = argparse.ArgumentParser(
        prog="cputune", usage="cputune [COMMAND] [OPTIONS]", description=HELP, parents=[common],
        formatter_class=HelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"cputune {__version__}")
    sub = parser.add_subparsers(prog="cputune", dest="name", help=argparse.SUPPRESS)  # HELP groups the commands by task
    cpu_help = "CPUs to use; their SMT siblings are locked too (default: the best-ranked core without CPU 0)"

    watch = argparse.ArgumentParser(add_help=False)
    watch.add_argument("--interval", type=float, default=1.0, metavar="S", help="seconds per update (default: 1)")
    watch.add_argument("--count", type=int, default=0, metavar="N", help="stop after N updates")

    p = sub.add_parser("show", parents=[common, watch],
                       help="cores, settings and what can make results vary (default command)")
    p.add_argument("-w", "--watch", action="store_true", help="live view of the core frequencies")
    p.add_argument("--now", action="store_true", help="also measure the current frequency (1 s)")
    p.set_defaults(func=cmd_show)

    # Hidden (no help=): "cputune -w" and "cputune" replace them. Kept so that scripts keep working.
    p = sub.add_parser("watch", parents=[common, watch])
    p.set_defaults(func=cmd_watch)
    p = sub.add_parser("check", parents=[common])
    p.add_argument("-c", "--cpu", metavar="CPUS", help="CPUs to check (default: the core that run uses)")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("lock", parents=[common], help="lock cores to one frequency, boost off")
    p.add_argument("freq", nargs="?", type=parse_freq, metavar="FREQ", help="frequency (default: base)")
    p.add_argument("-c", "--cpu", metavar="CPUS", help=cpu_help)
    p.add_argument("--exclusive", action="store_true",
                   help="fail when cputune already changed settings")
    p.set_defaults(func=cmd_lock)

    p = sub.add_parser("run", parents=[common], help="lock, run a command on the locked core, reset",
                       usage="cputune run [FREQ] [--cpu CPUS] [--strict] -- COMMAND [ARG ...]")
    p.add_argument("freq", nargs="?", type=parse_freq, metavar="FREQ", help="frequency (default: base)")
    p.add_argument("-c", "--cpu", metavar="CPUS", help=cpu_help)
    p.add_argument("--strict", action="store_true",
                   help="do not run COMMAND when the measured frequency is not the lock")
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("limit", parents=[common], help="set the frequency range of cores")
    p.add_argument("--min", type=parse_freq, metavar="FREQ", help="lowest frequency")
    p.add_argument("--max", type=parse_freq, metavar="FREQ", help="highest frequency")
    p.add_argument("-c", "--cpu", metavar="CPUS", help="CPUs (default: all)")
    p.set_defaults(func=cmd_limit)

    p = sub.add_parser("reset", parents=[common], help="undo all changes of lock, run and limit")
    p.set_defaults(func=cmd_reset)

    p = sub.add_parser("sudoers", parents=[common], help="show how to run cputune without a password prompt")
    p.add_argument("--install", action="store_true", help="set it up: install the rule (and cputune, if needed)")
    p.add_argument("--rule", action="store_true", help="print only the sudo rule")
    p.set_defaults(func=cmd_sudoers, no_check=False)

    p = sub.add_parser(
        "install", parents=[common], help="install to ~/.local/bin, or to /usr/local/bin with --system",
        description="Installs the newer of this file and the latest release on GitHub, or updates to it. "
        "Only one copy stays: when /usr/local/bin/cputune exists, install updates that one.",
    )
    p.add_argument("--system", action="store_true", help="install to /usr/local/bin, owned by root (uses sudo)")
    p.add_argument("--no-password", action="store_true",
                   help="also allow lock, run, limit and reset without a password: installs to /usr/local/bin "
                   "and adds a sudo rule for that copy (uses sudo)")
    p.add_argument("--no-check", action="store_true", help="install this file, do not look on GitHub")
    p.set_defaults(func=cmd_install, install=True, rule=False)  # install, rule: for --no-password

    p = sub.add_parser("update", parents=[common], help="update this copy to the newest version on GitHub")
    p.set_defaults(func=cmd_update)
    return parser


def with_default_command(argv: list[str]) -> list[str]:
    """No command given: use "show". "cputune --json" is "cputune show --json"."""
    if any(a in ("-h", "--help", "--version") or a in COMMANDS for a in argv):
        return argv
    expect_value = False
    for a in argv:
        if expect_value:
            expect_value = False
        elif a in ("--color", "--interval", "--count"):
            expect_value = True
        elif not a.startswith("-"):
            return argv  # an unknown command: argparse reports it
    return ["show", *argv]


def main() -> int:
    global COLOR, COMMAND, JSON, OUT
    argv = sys.argv[1:]
    command: list[str] = []
    if "--" in argv:
        i = argv.index("--")
        argv, command = argv[:i], argv[i + 1 :]
    argv = with_default_command(argv)
    parser = build_parser()
    args = parser.parse_args(argv)
    args.command = command
    args.json = getattr(args, "json", False)
    if args.name == "run":
        OUT = sys.stderr
    JSON, COMMAND = args.json, args.name
    COLOR = not JSON and want_color(getattr(args, "color", "auto"), OUT)
    args.argv = [*argv, f"--color={'always' if COLOR else 'never'}"]  # for the run as root
    name = args.name
    if command and args.func is not cmd_run:
        parser.error("'-- COMMAND' is only for: cputune run [FREQ] [--cpu CPUS] -- COMMAND")
    if UNDER_SUDO and name not in SUDO_COMMANDS:
        print(f"cputune: error: do not start 'cputune {name}' with sudo. cputune runs sudo "
              f"itself when it needs root. Under sudo, only these commands work: {', '.join(SUDO_COMMANDS)}",
              file=sys.stderr)
        return 1

    try:
        args.func(args)
    except Error as e:
        if args.json:
            print_json({"ok": False, "error": str(e)})
        print(paint(f"cputune: error: {e}", BOLD, RED), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
