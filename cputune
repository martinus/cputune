WARNINGS: list[str] = []
OUT = sys.stdout  # "run" sends its own messages to stderr, so stdout stays the benchmark's


def fg(n: int) -> str:
    return f"38;5;{n}"


BOLD = "1"
WHITE = fg(255)
GRAY = fg(245)
DARK = fg(239)
BLUE = fg(39)
ORANGE = fg(208)
MAGENTA = fg(213)
GREEN = fg(78)
YELLOW = fg(221)
RED = fg(203)
# Frequency colors, from cold (low MHz) to hot (high MHz).
HEAT = tuple(fg(n) for n in (27, 33, 39, 45, 51, 50, 49, 48, 47, 46, 82, 118, 154, 190, 226, 220, 214, 208, 202, 196))
EIGHTHS = " ▏▎▍▌▋▊▉"


def paint(text: str, *codes: str) -> str:
    if not COLOR or not codes or not text:
        return text
    return f"\033[{';'.join(codes)}m{text}\033[0m"


def heat(fraction: float) -> str:
    return HEAT[round(max(0.0, min(1.0, fraction)) * (len(HEAT) - 1))]


def say(text: str = "") -> None:
    """Text for people. Nothing with --json: then the JSON result says it all."""
    if not JSON:
        print(text, file=OUT)


def say_ok(text: str) -> None:
    say(paint("✓ ", BOLD, GREEN) + text)


def warn(msg: str) -> None:
    WARNINGS.append(msg)
    print(paint(f"cputune: warning: {msg}", YELLOW), file=sys.stderr)


def want_color(mode: str, stream) -> bool:
    if mode == "always":
        return True
    if mode == "never" or os.environ.get("NO_COLOR") or os.environ.get("TERM") == "dumb":
        return False
    return stream.isatty()


def print_json(data: dict) -> None:
    """The JSON result of a command. It starts with "ok": true and the command name."""
    data = {"ok": True, "command": COMMAND} | data
    if WARNINGS and "warnings" not in data:
        data["warnings"] = WARNINGS
    text = json.dumps(data, indent=2)
    # Lists of numbers on one line: "cpus": [1, 17]
    text = re.sub(
        r"\[\s+([-\d.,\s]+?)\s+\]", lambda m: "[" + ", ".join(x.strip() for x in m[1].split(",")) + "]", text
    )
    print(text, file=OUT)


# ------------------------------------------------------------------ read sysfs


def read_str(path: Path) -> str | None:
    """Read a string from a sysfs file. None when it does not exist or cannot be read."""
    try:
        return path.read_text().strip()
    except (OSError, UnicodeDecodeError):
        return None


def read_int(path: Path) -> int | None:
    try:
        return int(read_str(path))  # type: ignore[arg-type]
    except (TypeError, ValueError):
        return None


def fdir(cpu: int) -> Path:
    return CPU_BASE / f"cpu{cpu}/cpufreq"


def must_khz(cpu: int, name: str) -> int:
    """Read a frequency file that must exist, for example scaling_max_freq."""
    if (value := read_int(fdir(cpu) / name)) is None:
        die(f"cannot read {fdir(cpu) / name}")
    return value


def freq_cpus() -> list[int]:
    """All CPUs that have cpufreq: they are online, and a driver is loaded."""
    cpus = []
    for path in CPU_BASE.glob("cpu*"):
        if re.fullmatch(r"cpu\d+", path.name) and (path / "cpufreq").is_dir():
            cpus.append(int(path.name[3:]))
    return sorted(cpus)


def parse_cpu_list(text: str) -> list[int]:
    """Parse a CPU list such as "0-3,8,10-11". Raises ValueError."""
    cpus: list[int] = []
    for part in text.strip().split(","):
        if not (m := re.fullmatch(r"\s*(\d+)\s*(?:-\s*(\d+)\s*)?", part)):
            raise ValueError(text)
        start = int(m[1])
        end = int(m[2]) if m[2] else start
        if end < start:
            raise ValueError(text)
        cpus.extend(range(start, end + 1))
    return cpus


def format_cpu_list(cpus) -> str:
    """[0, 1, 2, 3, 8] -> "0-3,8". Two neighbors stay a list: [4, 5] -> "4,5"."""
    cpus = sorted(set(cpus))
    parts = []
    i = 0
    while i < len(cpus):
        j = i
        while j + 1 < len(cpus) and cpus[j + 1] == cpus[j] + 1:
            j += 1
        if j - i >= 2:
            parts.append(f"{cpus[i]}-{cpus[j]}")
        else:
            parts.extend(str(c) for c in cpus[i : j + 1])
        i = j + 1
    return ",".join(parts)


def get_rank(cpu: int) -> int:
    """The rank that the scheduler uses to prefer cores. Higher is faster."""
    d = CPU_BASE / f"cpu{cpu}"
    for path in (
        d / "acpi_cppc/highest_perf",  # AMD, and some others with CPPC
        d / "cpufreq/amd_pstate_prefcore_ranking",
        d / "topology/itmt_score",  # Intel Turbo Boost Max 3.0
    ):
        if (rank := read_int(path)) is not None:
            return rank
    return 100


def base_khz(cpu: int, guess: bool = False) -> int | None:
    """The base (nominal) frequency in kHz.

    With guess=True, use the best value available when the hardware does not
    report a base frequency. Read this after boost is off.
    """
    d = fdir(cpu)
    for name in ("base_frequency", "amd_pstate_nominal_freq"):  # Intel; AMD before 6.x
        if value := read_int(d / name):
            return value
    if value := read_int(CPU_BASE / f"cpu{cpu}/acpi_cppc/nominal_freq"):  # in MHz
        return value * 1000
    if not guess:
        return None
    return top_pstate_khz(cpu) or read_int(d / "cpuinfo_max_freq")


def top_pstate_khz(cpu: int) -> int | None:
    """acpi-cpufreq: the highest P-state in kHz (the base frequency). Software cannot set more:
    the kernel keeps scaling_max_freq there, and with boost on, the hardware goes above it.
    None for other drivers."""
    try:
        return max(int(f) for f in (read_str(fdir(cpu) / "scaling_available_frequencies") or "").split())
    except ValueError:
        return None


def boost_switch(cpu: int) -> tuple[Path, str, str] | None:
    """The boost switch for this CPU: (file, value for "boost off", "core" or "global").

    A per-core switch comes first, so that the other cores keep boost.
    """
    if (path := fdir(cpu) / "boost").exists():
        return path, "0", "core"  # amd-pstate on new kernels
    if (path := CPU_BASE / "intel_pstate/no_turbo").exists():
        return path, "1", "global"  # inverted logic
    if (path := CPU_BASE / "cpufreq/boost").exists():
        return path, "0", "global"  # acpi-cpufreq, older amd-pstate
    return None


def is_boost_switch(path: Path) -> bool:
    """True for a file that boost_switch() can return. reset writes only to these."""
    return path in (CPU_BASE / "intel_pstate/no_turbo", CPU_BASE / "cpufreq/boost") or (
        path.name == "boost"
        and path.parent.name == "cpufreq"
        and path.parent.parent.parent == CPU_BASE
        and re.fullmatch(r"cpu\d+", path.parent.parent.name) is not None
    )


# Core attribute and the cpufreq file that it comes from (kHz in the file, MHz in Core).
CORE_FREQ_FILES = (("hw_min", "cpuinfo_min_freq"), ("hw_max", "cpuinfo_max_freq"),
                   ("set_min", "scaling_min_freq"), ("set_max", "scaling_max_freq"))


class Core:
    """One physical core, with all its SMT siblings. Frequencies are in MHz, 0 = unknown."""

    __slots__ = ("cpus", "rank", "hw_min", "hw_max", "base", "set_min", "set_max", "top_pstate", "now")

    def __init__(self, cpus: tuple[int, ...], rank: int, hw_min: int = 0, hw_max: int = 0,
                 base: int | None = None, set_min: int = 0, set_max: int = 0, top_pstate: int = 0) -> None:
        self.cpus, self.rank, self.base = cpus, rank, base
        self.hw_min, self.hw_max, self.set_min, self.set_max = hw_min, hw_max, set_min, set_max
        self.top_pstate = top_pstate  # acpi-cpufreq, see top_pstate_khz; else 0
        self.now: int | None = None

    @property
    def has_freq(self) -> bool:
        return self.hw_max > 0

    @property
    def locked(self) -> bool:
        return self.has_freq and self.set_min == self.set_max

    @property
    def open_max(self) -> int:
        """The set maximum that means "no limit": hw_max, or the highest P-state of acpi-cpufreq."""
        return min(self.hw_max, self.top_pstate) if self.top_pstate else self.hw_max

    @property
    def reach_max(self) -> int:
        """The highest frequency that the set range allows."""
        return self.hw_max if self.set_max >= self.open_max else self.set_max

    @property
    def limited(self) -> bool:
        return self.has_freq and (self.set_min != self.hw_min or self.set_max < self.open_max)

    def to_json(self) -> dict:
        return {
            "rank": self.rank,
            "cpus": list(self.cpus),
            "hw_min_mhz": self.hw_min or None,
            "hw_max_mhz": self.hw_max or None,
            "base_mhz": self.base,
            "min_mhz": self.set_min or None,
            "max_mhz": self.set_max or None,
            "locked": self.locked,
            "now_mhz": self.now,
        }


def get_cores() -> list[Core]:
    """All physical cores, best rank first. On a tie, the lowest CPU IDs come first."""
    groups: set[tuple[int, ...]] = set()
    for path in CPU_BASE.glob("cpu*"):
        if re.fullmatch(r"cpu\d+", path.name):
            if siblings := read_str(path / "topology/thread_siblings_list"):
                try:
                    groups.add(tuple(sorted(parse_cpu_list(siblings))))
                except ValueError:
                    pass

    grouped = {cpu for g in groups for cpu in g}
    groups |= {(cpu,) for cpu in freq_cpus() if cpu not in grouped}  # no topology files

    cores = []
    for cpus in groups:
        first = cpus[0]
        base = base_khz(first)
        mhz = {attr: (read_int(fdir(first) / name) or 0) // 1000 for attr, name in CORE_FREQ_FILES}
        top = (top_pstate_khz(first) or 0) // 1000
        cores.append(Core(cpus, get_rank(first), base=base // 1000 if base else None, top_pstate=top, **mhz))
    cores.sort(key=lambda c: (-c.rank, c.cpus))
    return cores


def default_lock_core(cores: list[Core]) -> Core:
    """The best-ranked core that does not hold CPU 0. CPU 0 often handles more interrupts."""
    usable = [c for c in cores if c.has_freq]
    if not usable:
        die("no CPU has cpufreq (no cpufreq driver loaded?)")
    for core in usable:
        if 0 not in core.cpus:
            return core
    return usable[0]


def system_info() -> dict:
    info: dict = {
        "cpu_model": None,
        "driver": None,
        "governor": None,
        "available_governors": [],
        "epp": None,
        "boost": None,
        "boost_off_cpus": [],
        "kernel": read_str(ROOT / "proc/sys/kernel/osrelease"),
        "kernel_version": read_str(ROOT / "proc/sys/kernel/version"),
    }
    try:
        with (ROOT / "proc/cpuinfo").open(encoding="utf8", errors="replace") as f:
            for line in f:
                key, _, value = line.partition(":")
                if key.strip() in ("model name", "Model"):  # x86; Raspberry Pi
                    info["cpu_model"] = value.strip()
                    break
    except OSError:
        pass

    cpus = freq_cpus()
    if cpus:
        d = fdir(cpus[0])
        info["driver"] = read_str(d / "scaling_driver")
        info["governor"] = read_str(d / "scaling_governor")
        info["available_governors"] = (read_str(d / "scaling_available_governors") or "").split()
        info["epp"] = read_str(d / "energy_performance_preference")

    if (boost := read_int(CPU_BASE / "cpufreq/boost")) is not None:
        info["boost"] = boost == 1
    elif (no_turbo := read_int(CPU_BASE / "intel_pstate/no_turbo")) is not None:
        info["boost"] = no_turbo == 0
    per_core = {cpu: read_int(fdir(cpu) / "boost") for cpu in cpus}
    if info["boost"] is None and any(v is not None for v in per_core.values()):
        info["boost"] = any(v == 1 for v in per_core.values())
    if info["boost"]:
        info["boost_off_cpus"] = [cpu for cpu, v in per_core.items() if v == 0]
    return info


def state_exists() -> bool:
    """True when cputune changed settings in this boot.

    A reboot resets all settings, so a state file from an earlier boot is stale. /run is
    in memory and a reboot clears it, but the boot ID makes sure. Root deletes a stale file.
    """
    try:
        state = json.loads(STATE_FILE.read_text())
    except FileNotFoundError:
        return False
    except (OSError, ValueError):
        return True  # load_state reports the problem
    saved = state.get("boot_id") if isinstance(state, dict) else None
    now = read_str(BOOT_ID)
    if saved is None or now is None or saved == now:  # before 2.3.0, files had no boot ID
        return True
    if is_root():
        try:
            STATE_FILE.unlink()
        except OSError:
            pass
    return False


def load_state() -> dict:
    try:
        state = json.loads(STATE_FILE.read_text())
    except FileNotFoundError:
        return {"cpus": {}, "boost": {}}
    except (OSError, ValueError) as e:
        die(f"cannot read {STATE_SHOWN}: {e}. Delete it with: sudo rm {STATE_SHOWN}")
    cpus = state.get("cpus") if isinstance(state, dict) else None
    if not (isinstance(cpus, dict) and isinstance(state.get("boost"), dict) and all(
        cpu.isdigit() and isinstance(saved, dict) and isinstance(saved.get("min"), int)
        and isinstance(saved.get("max"), int) for cpu, saved in cpus.items()
    )):
        die(f"{STATE_SHOWN} is damaged. Delete it with: sudo rm {STATE_SHOWN}")
    return state


def state_cpus() -> list[int] | None:
    """The CPUs that cputune changed, or None when nothing is changed."""
    if not state_exists():
        return None
    try:
        return sorted(int(c) for c in load_state()["cpus"])
    except (Error, ValueError):
        return []


# ------------------------------------------------------------------ measure


def cpu_khz(cpu: int, read=None, busy_only: bool = False) -> int | None:
    """The current frequency of a CPU in kHz. All of cputune reads it here.

    cpuinfo_avg_freq (new kernels) is what the hardware counted, but it has no value while the
    CPU sleeps: then scaling_cur_freq. busy_only=True: None instead, for run, which measures only
    the CPUs that do work. read: read_int, or FdReader.int for repeated reads.
    """
    read = read or read_int
    avg = fdir(cpu) / "cpuinfo_avg_freq"
    if khz := read(avg):
        return khz
    if busy_only and avg.exists():
        return None
    return read(fdir(cpu) / "scaling_cur_freq") or None


def measure(cpus: list[int], seconds: float = 1.0) -> dict[int, int]:
    """Average frequency of each CPU in MHz, sampled over some time."""
    samples = 5
    values: dict[int, list[int]] = {cpu: [] for cpu in cpus}
    for i in range(samples):
        if i:
            pause(seconds / samples)
        for cpu in cpus:
            if khz := cpu_khz(cpu):
                values[cpu].append(khz)
    return {cpu: sum(v) // len(v) // 1000 if v else 0 for cpu, v in values.items()}


def measure_under_load(cpus: list[int]) -> dict[int, int]:
    """Put a busy loop on each CPU and measure. An idle core shows no useful frequency."""
    import subprocess

    procs = []
    if not TEST_MODE:
        for cpu in cpus:
            code = (
                "import os, sys\n"
                f"try: os.sched_setaffinity(0, {{{cpu}}})\n"
                "except OSError: sys.exit()\n"
                "while True: pass"
            )
            # -I -S: no site packages, no user paths. Starts faster, and needs only os and sys.
            procs.append(subprocess.Popen([sys.executable, "-I", "-S", "-c", code], stdin=subprocess.DEVNULL))
        pause(0.3)
    try:
        return measure(cpus, 0.7)
    finally:
        for p in procs:
            p.kill()
            p.wait()


# ------------------------------------------------------------------ render


def bar(core: Core, scale: int, width: int, now: int | None) -> str:
    """One row of the frequency chart. scale is the MHz at the right end."""

    def cell(mhz: float) -> int:
        return min(width - 1, max(0, int(mhz / scale * width)))

    cells: list[tuple[str, tuple[str, ...]]] = [(" ", ())] * width
    if not core.has_freq:
        return paint("no cpufreq".ljust(width), GRAY)

    for i in range(cell(core.hw_min), cell(core.hw_max) + 1):
        mhz = (i + 0.5) * scale / width
        if mhz < core.set_min - scale / width or mhz > core.reach_max + scale / width:
            cells[i] = ("─", (DARK,))
        elif core.base and mhz > core.base + scale / width / 2:
            cells[i] = ("╍", (ORANGE,))
        else:
            cells[i] = ("━", (BLUE,))
    if now:
        filled = min(width, now / scale * width)
        full = int(filled)
        for i in range(full):
            cells[i] = ("█", (heat(i / width),))
        if full < width and (part := int((filled - full) * 8)):
            cells[full] = (EIGHTHS[part], (heat(full / width),))
    if core.locked:  # on top of the "now" bar
        cells[cell(core.set_max)] = ("◆", (BOLD, MAGENTA))

    out = ""
    run, run_style = "", ()
    for ch, style in cells:
        if style != run_style:
            out += paint(run, *run_style)
            run, run_style = "", style
        run += ch
    return out + paint(run, *run_style)


def axis(scale: int, width: int, step: int) -> str:
    """Tick labels for the header row of the chart, width characters: "0 GHz     2     4"."""
    chars = [" "] * width
    for mhz in range(0, scale + 1, step):
        label = f"{mhz / 1000:g}" + (" GHz" if mhz == 0 else "")
        pos = min(width - 1, int(mhz / scale * width))
        if pos + len(label) <= len(chars) and all(c == " " for c in chars[max(0, pos - 1) : pos + len(label)]):
            chars[pos : pos + len(label)] = label
    return "".join(chars)


def visible_len(text: str) -> int:
    """The length of text on the terminal, without color codes."""
    return len(re.sub(r"\033\[[0-9;]*m", "", text))


def render_show(cores: list[Core], info: dict, measured: bool, changed: list[int] | None) -> list[str]:
    """The show text. changed: the CPUs that cputune changed (state_cpus())."""
    if not cores:
        return [*render_header(cores, info, 0), "No CPU topology found in sysfs."]
    freq = [c for c in cores if c.has_freq]
    table = render_table(cores, freq, measured)
    lines = render_header(cores, info, max(map(visible_len, table)))
    lines += table
    if freq:
        lines += ["", *render_legend(freq, measured)]
    if changed is not None:
        cpus = format_cpu_list(changed) if changed else "?"
        lines += ["", paint("● ", YELLOW) + f"cputune changed cpu {paint(cpus, BOLD, WHITE)}. "
                  + f"Undo with: {paint('cputune reset', BOLD, WHITE)}"]
    return lines


def render_header(cores: list[Core], info: dict, width: int) -> list[str]:
    """CPU model and kernel (right-aligned to width, the width of the table), then driver, governor,
    EPP and boost, then an empty line."""
    def kv(key: str, value: str) -> str:
        return f"{paint(key, GRAY)} {value}"

    n_cpus = sum(len(c.cpus) for c in cores)
    model = paint(info["cpu_model"] or "unknown CPU", BOLD, WHITE)
    model += paint(f"   {len(cores)} cores, {n_cpus} CPUs", GRAY)
    governors = " ".join(info["available_governors"])
    parts = [
        kv("driver", paint(info["driver"] or "none", WHITE)),
        kv("governor", paint(info["governor"] or "none", WHITE) + paint(f" ({governors})" if governors else "", GRAY)),
    ]
    if info["epp"]:
        parts.append(kv("epp", paint(info["epp"], WHITE)))
    if info["boost"] is None:
        boost = paint("no switch", GRAY)
    elif info["boost"]:
        boost = paint("on", BOLD, ORANGE)
        if info["boost_off_cpus"]:
            boost += paint(f" (off on cpu {format_cpu_list(info['boost_off_cpus'])})", BLUE)
    else:
        boost = paint("off", BOLD, BLUE)
    parts.append(kv("boost", boost))
    lines = [model, paint(" · ", DARK).join(parts)]
    if info["kernel"]:
        kernel = kv("kernel", paint(info["kernel"], WHITE))
        gap = max(3, width - visible_len(model) - visible_len(kernel))
        if visible_len(model) + gap + visible_len(kernel) < shutil.get_terminal_size((100, 24)).columns:
            lines[0] += " " * gap + kernel
        else:
            lines.append(kernel)  # too long for one line
    return [*lines, ""]


def rank_color(rank: int, lo: int, hi: int) -> tuple[str, ...]:
    """Green for the best rank, then light green, yellow and orange."""
    if hi == lo:
        return (WHITE,)
    f = (rank - lo) / (hi - lo)
    if f > 0.99:
        return (BOLD, GREEN)
    if f > 0.6:
        return (fg(150),)
    return (YELLOW,) if f > 0.3 else (ORANGE,)


def mhz_cell(mhz: int | None, width: int = 5) -> str:
    return f"{mhz or '–':>{width}}"


def render_table(cores: list[Core], freq: list[Core], measured: bool) -> list[str]:
    """One row per core, best rank first: rank, CPUs, min/base/max, the chart, and the set and
    measured frequency when there are any."""
    lines = [] if freq else [paint("No cpufreq driver: frequencies are not available.", GRAY)]
    default = default_lock_core(cores).cpus if freq else ()

    # Column layout. Each SMT sibling gets its own right-aligned column: " 1 17", "13 29".
    sib_w = [
        max(len(str(c.cpus[i])) for c in cores if len(c.cpus) > i)
        for i in range(max(len(c.cpus) for c in cores))
    ]
    cpus_w = max(4, sum(sib_w) + len(sib_w) - 1)

    def cpus_cell(cpus: tuple[int, ...]) -> str:
        cells = [
            paint(f"{cpus[i]:>{w}}", WHITE if i == 0 else GRAY) if i < len(cpus) else " " * w
            for i, w in enumerate(sib_w)
        ]
        return " ".join(cells) + " " * (cpus_w - sum(sib_w) - len(sib_w) + 1)

    show_set = any(c.limited for c in cores)
    left_w = 4 + 2 + cpus_w + 2 + 3 * 6 + 2  # up to the chart
    right_w = (12 if show_set else 0) + (9 if measured else 0)
    columns = shutil.get_terminal_size((100, 24)).columns
    width = max(20, min(60, columns - left_w - right_w - 1))
    top = max((c.hw_max for c in freq), default=1000)
    step = 1000 if top >= 2500 else 500
    scale = math.ceil(top / step) * step
    lo_rank, hi_rank = min(c.rank for c in cores), max(c.rank for c in cores)

    chart_head = axis(scale, width, step) if freq else " " * width
    head = f"{'rank':>4}  {'cpus':<{cpus_w}}   {'min':>5} {'base':>5} {'max':>5}  " + chart_head
    if show_set:
        head += f"  {'set MHz':>10}"
    if measured:
        head += f"  {'now MHz':>7}"
    lines.append(paint(head.rstrip(), GRAY))

    for core in cores:
        star = paint("★", BOLD, YELLOW) if core.cpus == default else " "
        row = paint(f"{core.rank:>4}", *rank_color(core.rank, lo_rank, hi_rank))
        row += "  " + cpus_cell(core.cpus) + " " + star
        row += " " + " ".join(paint(mhz_cell(v), GRAY) for v in (core.hw_min, core.base, core.hw_max)) + "  "
        row += bar(core, scale, width, core.now if measured else None)
        if show_set:
            if core.locked:
                row += "  " + paint(f"{'◆ ' + str(core.set_max):>10}", BOLD, MAGENTA)
            elif core.limited:
                row += "  " + paint(f"{core.set_min}-{core.set_max}".rjust(10), BLUE)
            else:
                row += " " * 12
        if measured:
            row += "  " + paint(mhz_cell(core.now, 7), BOLD, heat((core.now or 0) / scale))
        lines.append(row.rstrip())
    return lines


def render_legend(freq: list[Core], measured: bool) -> list[str]:
    """What the marks in the chart mean: only the marks that the chart shows, in their chart colors.
    Wrapped between the marks to the width of the terminal."""
    boost = any(c.base and c.base < c.hw_max for c in freq)
    marks = [("━", (BLUE,), "min to base" if boost else "min to max")]
    if boost:
        marks.append(("╍", (ORANGE,), "boost, above base"))
    if any(c.limited and not c.locked for c in freq):
        marks.append(("─", (DARK,), "outside the set range"))
    if any(c.locked for c in freq):
        marks.append(("◆", (BOLD, MAGENTA), "locked"))
    if measured:
        marks.append(("█", (heat(0.5),), "now"))
    marks.append(("★", (BOLD, YELLOW), "best core: lock and run use it"))
    items = [(f"{mark} {label}", paint(mark, *style) + paint(f" {label}", GRAY)) for mark, style, label in marks]
    items.append(("(all values in MHz)", paint("(all values in MHz)", GRAY)))
    columns = max(40, shutil.get_terminal_size((100, 24)).columns) - 1
    lines, plain, colored = [], "", ""
    for text, painted in items:
        if plain and len(plain) + 3 + len(text) > columns:
            lines.append(colored)
            plain, colored = "", ""
        if plain:
            plain, colored = plain + "   ", colored + "   "
        plain, colored = plain + text, colored + painted
    return [*lines, colored]


def show_json(cores: list[Core], info: dict, command: str, changed: list[int] | None) -> dict:
    freq = [c for c in cores if c.has_freq]
    return {
        "ok": True,
        "command": command,
        "version": __version__,
        "system": info | {"cores": len(cores), "cpus": sum(len(c.cpus) for c in cores)},
        "changed_by_cputune": None if changed is None else {"cpus": changed, "state_file": STATE_SHOWN},
        "default_lock_cpus": list(default_lock_core(cores).cpus) if freq else None,
        "cores": [c.to_json() for c in cores],
    }


