class Error(Exception):
    """A problem to report to the user, without a traceback."""


def die(msg: str) -> NoReturn:
    raise Error(msg)


def is_root() -> bool:
    """Root, or the tests: then cputune changes the files itself, without sudo."""
    return os.geteuid() == 0 or TEST_MODE


def pause(seconds: float) -> None:
    """time.sleep, but not in tests: the fake files do not change anyway."""
    if not TEST_MODE:
        time.sleep(seconds)


